# Base URL of the mock server (frontendchallengeserver). Default assumes `npm start` on port 3000.
VITE_API_BASE_URL=http://localhost:3000

# Path params for the action-blueprint-graph-get endpoint.
# The mock server returns graph.json regardless of these values, but they are
# kept configurable so the same client works against a real backend.
VITE_TENANT_ID=1
VITE_BLUEPRINT_ID=bp_01jk766tckfwx84xjcxazggzyc
